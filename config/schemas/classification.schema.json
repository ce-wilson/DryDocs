{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "drydocs:config/schemas/classification.schema.json",
  "title": "config/classification.yaml (drydocs.classification.v1)",
  "description": "Shape only (S6). Cross-file semantics (every source classified, retired-tier absence, API vocabulary agreement) live in tests/unit/test_classification.py.",
  "type": "object",
  "required": [
    "schema",
    "updated",
    "levels",
    "publish_rule"
  ],
  "properties": {
    "schema": {
      "const": "drydocs.classification.v1"
    },
    "updated": {
      "description": "date or string (YAML parses bare dates)"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rank",
          "publishable",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          },
          "publishable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "homes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "publish_rule": {
      "type": "object"
    },
    "required_on_every_source": {},
    "required_for_external": {},
    "public_producer": {},
    "sanitize": {},
    "excluded_paths": {}
  }
}
