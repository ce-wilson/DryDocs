# Credentials — never commit these
# .env, .env.local, ".env copy.example" — any variant may hold real secrets;
# the committed template (.env.example) is re-included below.
.env*
!.env.example
Neo4j-*.txt

# Local Claude settings (machine-local paths / personal permission rules)
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
dist/
build/
*.egg-info/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Sample / local data — may contain sensitive source data
drydocs/data/
# Staging / extract output (real data — keep local, never commit)
stg_out/
/stg_*/

# SDLC-Docs — Fidelity-internal source corpus: keep LOCAL for reference, never commit/publish.
# Internal-Confidential per PUBLISH-BOUNDARY.md (real org name "Fidelity/FMR", internal fmr.com
# URLs, internal tool/standard code names). Ignore the WHOLE corpus (docx/doc/pdf/xls/txt/json,
# any type) and keep only the clean design artifacts SDLC-Docs/extracted/*.md tracked.
/SDLC-Docs/*
!/SDLC-Docs/extracted/
/SDLC-Docs/extracted/*
!/SDLC-Docs/extracted/*.md

# Local doc-extraction helper scripts (temporary; generated the SDLC-Docs corpus)
/.tmp_*

# Oracle Kerberos connection — the FILLED config holds a real SID/hosts/alias.
# Only the .sample.txt is committed.
libs/oracle_kerberos/oracle_kerberos_connection.txt

# Local real-data working area (Internal-Confidential): consolidated
# troubleshooting notes, screenshots with live values, filled configs.
# Never committed; travels to the company side by hand, not by git.
/internal-local/

# Raw screenshots dropped in the repo root during troubleshooting/porting —
# they contain live SIDs, hostnames, EPV objects, ADFS client IDs. Never commit.
# (Move them into internal-local/ when done; ignored here as a safety net.)
/oracle-connection-*.png
/raiidr-*.png
/ss-*.png

# Editor workspace settings (machine-local)
/.vscode/

# OS
.DS_Store
Thumbs.db
