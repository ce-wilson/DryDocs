# drydocs-web — copy to .env.local (gitignored) and fill in.
# NOTE (ADR 0005): NEVER define VITE_NEO4J_PASSWORD here or in CI — Vite inlines
# VITE_* values into the built bundle, so a committed/injected password becomes a
# secret inside a publishable artifact. The dev-mode bolt panel takes the password
# as form input at runtime only.
# Canonical local instance names/ports: config/dev-environment.yaml
VITE_NEO4J_URI=bolt://localhost:7687
VITE_NEO4J_USER=neo4j
# The PROJECT database (config/dev-environment.yaml `ground_truth`), which is also
# the console's built-in default with no env file present (O83). Not the driver's
# home database: nothing this console reads lives there.
VITE_NEO4J_DATABASE=drydocs
VITE_ADK_URL=http://localhost:8000
# drydocs-api (the thin API, ADR 0005) — the Graph view's default data path
VITE_API_URL=http://localhost:8001

# O39 (DL-8) — optional runtime-view deep-link template. When set, entity
# surfaces (inspector, IdChips) render an external-link affordance into the
# runtime monitor; unset = no affordance renders at all. {kind} is one of
# job|folder|dataset|run; {id} is URI-encoded. The REAL URL is company config
# (DD-series) — never commit a company hostname here.
# VITE_RUNTIME_VIEW_URL_TEMPLATE="https://runtime.example.internal/{kind}/{id}"
