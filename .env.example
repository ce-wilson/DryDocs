# =============================================================================
# DryDocs -- environment variables template
#
# GENERATED from drydocs_core/env_refs.py. Do not edit this file: run
#     poetry run python scripts/render_env_example.py
# after changing a declaration. A key added here alone is a key no binding may
# reference, because config/source-bindings.yaml resolves through the declared
# list and nothing else (ADR 0017 clause 3, G125).
#
# Copy to `.env` and fill in values; `.env` is gitignored. To set one without it
# reaching your shell history, the process table, or a screen share:
#     poetry run python scripts/set_env_var.py <NAME>
# To see what is set on this machine without printing any value:
#     poetry run drydocs env-doctor
# =============================================================================

# ---------------------------------------------------------------------------
# Neo4j connection (required)
# ---------------------------------------------------------------------------

# bolt URI of the destination graph.
# REQUIRED -- there is no default and an unset value fails naming it.
# NEO4J_USER maps to the `user` field in Neo4jSettings (prefix NEO4J_), which is
# why no text search finds these names in the code -- read the settings class,
# not the tree (J37). Canonical local dev/test instance: config/dev-environment.yaml.
NEO4J_URI=bolt://localhost:7687

# graph user.
# REQUIRED -- there is no default and an unset value fails naming it.
NEO4J_USER=neo4j

# graph password.
# REQUIRED -- there is no default and an unset value fails naming it.
# SECRET -- masked wherever the system prints, and never given an example.
# No example value, deliberately: a placeholder password in a template is a
# password somebody ships. Type it at a no-echo prompt instead --
#   poetry run python scripts/set_env_var.py NEO4J_PASSWORD
NEO4J_PASSWORD=

# target topology database (ADR 0002).
# Target a topology database (ADR 0002), NOT the EE home db `neo4j` -- ground
# truth loads go to `drydocs`. Provision first: drydocs_core/schema/provisioning/.
NEO4J_DATABASE=drydocs

# server import directory for bulk-import flows.
# The server's import directory. Leave empty unless a loader's docs ask for it.
NEO4J_IMPORT_DIR=

# local container name (config/dev-environment.yaml).
# The local EE container. Declared here because first-party code reads it and
# nothing declared it until G125 -- one of the eight.
NEO4J_CONTAINER=

# ---------------------------------------------------------------------------
# Data root and log roots
# ---------------------------------------------------------------------------

# root for every source drop and every output the system writes (G81).
# REQUIRED -- there is no default and an unset value fails naming it.
# MANDATORY since 2026-08-23: there is no default. Every source drop and every
# output the system writes is rooted here, and an unset variable used to
# relocate all of them silently to ~/data/DryDocs -- which is how a write lands
# on somebody else's source data. Point it at YOUR data root (a real local path;
# never committed). See config/dev-environment.yaml and config/data-zones.yaml.
DRYDOCS_DATA_ROOT=

# root for loader and supplement run logs (ADR 0014 clause 1).
# Deprecated alias(es), still honored: SPIDERP_LOGDIR.
# OPTIONAL, unlike the data root above: it defaults to ~/logs/DryDocs, and a
# relocated log is annoying where a relocated data root is destructive (G81 (d)
# names the DATA root deliberately, and config/data-zones.yaml records the same
# scope fence on the run-logs zone). Every loader and supplement run log lands
# here. SPIDERP_LOGDIR is still honored as a deprecated alias on both log
# families and is dropped at the cycle ADR 0014 clause 1 names -- set this one.
DRYDOCS_LOGDIR=

# fallback level for a log kind that declares none.
# Level and retention are the FALLBACKS a log kind inherits when it declares
# none of its own -- the per-kind values live in config/log-kinds.yaml (ADR 0014
# clause 1 as amended: per KIND, not one global set). Setting these changes what
# an undeclared kind gets, not what `qa` or `api` get.
DRYDOCS_LOG_LEVEL=INFO

# fallback retention for a log kind that declares none.
DRYDOCS_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Machine-local paths and identity (optional -- all have defaults)
# ---------------------------------------------------------------------------

# extra browser origins drydocs-api accepts, comma-separated (O80 e2e).
# ADDS to the built-in dev origins (vite dev 5173, vite preview 4173); it never
# replaces them, so an empty or unset value leaves the allowlist exactly as it
# has always been. It exists because the allowlist was HARDCODED, which made the
# console untestable anywhere but those two ports: the end-to-end suite needs its
# own port so it never adopts, collides with, or has to stop a dev server
# somebody is using, and a browser origin the API does not name fails every
# preflight with no Access-Control-Allow-Origin. Entries are taken verbatim --
# `*` is NOT special-cased here, and setting it would be a decision about a
# deployed API rather than a convenience for a test.
DRYDOCS_CORS_ORIGINS=http://localhost:5273

# path to the machine-local console credential file (O69/O73).
# SECRET -- masked wherever the system prints, and never given an example.
# A PATH, not a secret -- and declared secret anyway, because the file it points
# at IS the credential store, and a path naming an operator's home directory is
# still worth masking in a shared terminal. Defaults into internal-local/. Write
# the credentials themselves with scripts/set_console_credential.py, never by hand.
DRYDOCS_CONSOLE_CREDENTIALS=

# path to the derived mapping read model (ADR 0009).
# Derived, gitignored and rebuildable -- override only to move it off the default.
DRYDOCS_MAPPING_DB=

# read-only toggle for the mapping store.
DRYDOCS_MAPPING_READ=

# path to the Control-M API adapter config.
# The adapter config carries CONNECTION COORDINATES, so it lives in the
# machine-local tree and this variable is the only committed thing that knows
# its name (CLAUDE.md section 3).
DRYDOCS_CONTROLM_API_CFG=

# agent registry key.
DRYDOCS_AGENT_REG_KEY=

# caller identity stamped on run logs.
# Deprecated alias(es), still honored: SPIDERP_CALLER.
# SPIDERP_CALLER is the deprecated alias, on the same cycle as SPIDERP_LOGDIR.
DRYDOCS_CALLER=

# ---------------------------------------------------------------------------
# Oracle (optional -- the psgmgr replica; see config/source-bindings.yaml)
# ---------------------------------------------------------------------------

# Oracle account the psgmgr extracts read as.
ORACLE_USER=

# Oracle account password.
# SECRET -- masked wherever the system prints, and never given an example.
ORACLE_PASSWORD=

# Oracle connection descriptor -- a CONNECTION COORDINATE, twin-only.
# SECRET -- masked wherever the system prints, and never given an example.
# The descriptor IS the connection coordinate: host, port and service. It is
# twin-only and never committed in any form, which is exactly why a registry id
# may carry the schema NAME -- the name identifies, this reaches.
ORACLE_DSN=

# ---------------------------------------------------------------------------
# GitHub (optional -- code loader)
# ---------------------------------------------------------------------------

# code loader token.
# SECRET -- masked wherever the system prints, and never given an example.
GITHUB_TOKEN=

# code loader user.
GITHUB_USER=

# ---------------------------------------------------------------------------
# LLM keys (optional -- GraphRAG experiments)
# ---------------------------------------------------------------------------

# OpenAI key for GraphRAG experiments.
# SECRET -- masked wherever the system prints, and never given an example.
OPENAI_API_KEY=

# Anthropic key for GraphRAG experiments.
# SECRET -- masked wherever the system prints, and never given an example.
ANTHROPIC_API_KEY=

# model id for GraphRAG experiments.
ANTHROPIC_MODEL=claude-sonnet-4-6
