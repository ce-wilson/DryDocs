# =============================================================================
# DryDocs — environment variables template
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# =============================================================================

# --- Neo4j connection (required) ---------------------------------------------
# NEO4J_USER maps to the `user` field in Neo4jSettings (prefix NEO4J_).
# Canonical local dev/test instance: see config/dev-environment.yaml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# Target a topology database (ADR 0002), NOT the EE home db `neo4j` — ground truth
# loads go to `drydocs`. Provision first: drydocs_core/schema/provisioning/
NEO4J_DATABASE=drydocs
# Optional: the server's import directory, for bulk-import flows that stage
# files there. Leave empty unless a loader's docs ask for it.
NEO4J_IMPORT_DIR=

# --- Oracle (optional — M1+) -------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=

# --- GitHub (optional — code loader) -----------------------------------------
GITHUB_TOKEN=
GITHUB_USER=

# --- LLM keys (optional — GraphRAG experiments) ------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- data root (G81) --------------------------------------------------------
# MANDATORY since 2026-08-23: there is no default. Every source drop and every
# output the system writes is rooted here, and an unset variable used to
# relocate all of them silently to ~/data/DryDocs — which is how a write lands
# on somebody's source data. Point it at YOUR data root (real local path; never
# committed). See config/dev-environment.yaml and config/data-zones.yaml.
DRYDOCS_DATA_ROOT=

# ---- log directory (G109 (d)) -----------------------------------------------
# OPTIONAL, unlike the data root above: it defaults to ~/logs/DryDocs and a
# relocated log is annoying where a relocated data root is destructive (G81 (d)
# names the DATA root deliberately, and config/data-zones.yaml records the same
# scope fence on the run-logs zone). Every loader/supplement run log lands here.
# SPIDERP_LOGDIR is still honored as a deprecated alias on both log families and
# is dropped at the cycle ADR 0014 clause 1 names -- set this one, not that one.
DRYDOCS_LOGDIR=

# Level and retention are the FALLBACKS a log kind inherits when it declares none
# of its own -- the per-kind values live in config/log-kinds.yaml (ADR 0014
# clause 1 as amended: per KIND, not one global set). Setting these here changes
# what an undeclared kind gets, not what `qa` or `api` get.
DRYDOCS_LOG_LEVEL=INFO
DRYDOCS_LOG_RETENTION_DAYS=90
