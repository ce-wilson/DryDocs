# =============================================================================
# DryDocs — environment variables template
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# =============================================================================

# --- Neo4j connection (required) ---------------------------------------------
# NEO4J_USER maps to the `user` field in Neo4jSettings (prefix NEO4J_).
# Canonical local dev/test instance: see config/dev-environment.yaml.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# Target a topology database (ADR 0002), NOT the EE home db `neo4j` — ground truth
# loads go to `drydocs`. Provision first: drydocs_core/schema/provisioning/
NEO4J_DATABASE=drydocs

# --- Oracle (optional — M1+) -------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=

# --- GitHub (optional — code loader) -----------------------------------------
GITHUB_TOKEN=
GITHUB_USER=

# --- LLM keys (optional — GraphRAG experiments) ------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
