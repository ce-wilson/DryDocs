# CORPUS.docCount/totalChars/chunkCount are NOT in benchmark_p0_results.json
# (the benchmark never counts the whole corpus, only per-question retrieval
# sets) -- sourced instead from docmeta-p0-verdict.md's Setup table.
CORPUS_DOC_COUNT = 26  # Setup table: "bmc-docs (26 controlm-*.md, 313,350 chars)"
CORPUS_TOTAL_CHARS = 313_350
CORPUS_CHUNK_COUNT = 374
# NOTE — flagged, not resolved: this same JSON run's SA1.traversal.sample
# reports `"docs": 27` (one more than 26) via a live `MATCH (d:Document)`
# count. The likely explanation is that SOURCE-MANIFEST.md is itself loaded
# as a 27th :Document distinct from the 26 vendor controlm-*.md files the
# corpus is defined as -- but this script has no way to confirm that against
# the live DB, so it does not silently pick a number. Left for a human to
# check; CORPUS_DOC_COUNT keeps the verdict's explicit corpus definition
# (26 vendor files) rather than the raw graph count.


def _load_results() -> dict[str, dict]:
    rows = json.loads(RESULTS.read_text(encoding="utf-8"))
    by_id = {r["id"]: r for r in rows}
    missing = [qid for qid in QUESTION_IDS if qid not in by_id]
    if missing:
        raise SystemExit(f"benchmark_p0_results.json is missing question(s): {missing}")
    extra = set(by_id) - set(QUESTION_IDS)
    if extra:
        raise SystemExit(f"benchmark_p0_results.json has unexpected question(s) not in ADJUDICATED_KIND: {sorted(extra)}")
    return by_id


def _build_question_arm(qid: str, arm: str, raw_arms: dict) -> dict:
    kind = ADJUDICATED_KIND[qid][arm]
    armraw = raw_arms[arm]
    entry: dict = {"kind": kind}
    # chars is the real measured size from the JSON -- including "partial"
    # manifest answers (SA2, PV1): the verdict's own Arms table defines
    # manifest cost as "full text of the routed files", so the agent paid
    # that cost even though the reading only yielded a rule, not the number.
    # The one override: when the JSON's own `empty` flag is true, the "chars"
    # figure is just the length of the empty-list JSON string ("[]" == 2
    # chars), a serialization artifact, not retrieved content -- credit 0.
    entry["chars"] = 0 if armraw.get("empty") else armraw["chars"]
    if arm != "manifest":
        entry["ms"] = _round_half_up(armraw["ms"])
    if kind == "abstain":
        entry["qualifier"] = "correct"
    if arm == "manifest" and kind == "partial":
        entry["qualifier"] = "rule only"
    if arm == "traversal" and "traversal_naive" in raw_arms:
        naive = raw_arms["traversal_naive"]
        if naive["empty"] or not naive["marker_found"]:
            entry["qualifier"] = "informed"
    return entry


def build_questions() -> list[dict]:
    by_id = _load_results()
    out = []
    for qid in QUESTION_IDS:
        raw = by_id[qid]
        q = dict(
            id=qid,
            cls=QUESTION_CLASS[qid],
            text=QUESTION_TEXT[qid],
            note=QUESTION_NOTE[qid],
            cypher=QUESTION_CYPHER.get(qid),
        )
        for arm in ("traversal", "fulltext", "manifest"):
            q[arm] = _build_question_arm(qid, arm, raw["arms"])
        out.append(q)
    return out


def build_corpus_tiers() -> list[dict]:
    by_id = _load_results()
    sample = by_id["SA2"]["arms"]["traversal"]["sample"]
    tiers_raw = json.loads(sample)  # mechanically parsed from the real run, not retyped
    token_by_tier = {"GROUNDED": "--blue-br", "SYNTHESIZED": "--yellow", "VERBATIM": "--green"}
    return [
        dict(tier=t["provenance"], chunks=t["chunks"], chars=t["chars"], token=token_by_tier[t["provenance"]])
        for t in tiers_raw
    ]


def build_totals(questions: list[dict]) -> dict:
    totals = {}
    n = len(questions)
    for arm in ("traversal", "fulltext", "manifest"):
        chars_sum = sum(q[arm]["chars"] for q in questions)
        hits = sum(1 for q in questions if q[arm]["kind"] in ("pass", "abstain"))
        partial = sum(1 for q in questions if q[arm]["kind"] == "partial")
        recall = f"{hits}/{n}"
        if partial:
            recall += f" ({partial} partial)"
        tok_k = chars_sum / 4000.0
        entry = dict(chars=chars_sum, tokens=f"~{tok_k:.1f}k", recall=recall)
        if arm == "manifest":
            entry["latencyLabel"] = "routing ~instant"
        else:
            entry["latencyMedianMs"] = round(statistics.median(q[arm]["ms"] for q in questions))
        totals[arm] = entry
    return totals


def build_efficiency(totals: dict, questions: list[dict]) -> dict:
    manifest_chars = totals["manifest"]["chars"]
    traversal_chars = totals["traversal"]["chars"]
    headline = f"{manifest_chars / traversal_chars:.1f}\u00d7"
    ratios = [
        q["manifest"]["chars"] / q["traversal"]["chars"]
        for q in questions
        if q["traversal"]["chars"] > 0 and q["manifest"]["chars"] > 0
    ]
    per_question_range = f"{min(ratios):.0f}\u00d7\u2013{max(ratios):.0f}\u00d7" if ratios else "n/a"
    return dict(headline=headline, label="manifest-vs-traversal token efficiency", perQuestionRange=per_question_range)


def build_strategies(totals: dict) -> list[dict]:
    out = []
    for sid in ("manifest", "fulltext", "traversal"):
        meta = STRATEGY_META[sid]
        t = totals[sid]
        latency = t.get("latencyLabel") or f"{t['latencyMedianMs']}ms median"
        out.append(
            dict(
                id=sid,
                label=meta["label"],
                kicker=meta["kicker"],
                how=meta["how"],
                recall=t["recall"],
                tokens=f"\u2248{t['chars']:,} ch (~{t['tokens'].lstrip('~')} tok)",
                latency=latency,
                failureModes=meta["failureModes"],
                token=meta["token"],
            )
        )
    return out


# --- TS emission ------------------------------------------------------------


def _ts_str(s: str) -> str:
    escaped = s.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n")
    return f"'{escaped}'"


def _emit_strategies(strategies: list[dict]) -> str:
    lines = ["export const STRATEGIES: readonly StrategyInfo[] = ["]
    for s in strategies:
        lines.append("  {")
        lines.append(f"    id: {_ts_str(s['id'])},")
        lines.append(f"    label: {_ts_str(s['label'])},")
        lines.append(f"    kicker: {_ts_str(s['kicker'])},")
        lines.append(f"    how: {_ts_str(s['how'])},")
        lines.append(f"    recall: {_ts_str(s['recall'])},")
        lines.append(f"    tokens: {_ts_str(s['tokens'])},")
        lines.append(f"    latency: {_ts_str(s['latency'])},")
        lines.append(f"    failureModes: {_ts_str(s['failureModes'])},")
        lines.append(f"    token: {_ts_str(s['token'])},")
        lines.append("  },")
    lines.append("]")
    return "\n".join(lines)


def _emit_corpus(tiers: list[dict]) -> str:
    lines = ["export const CORPUS = {"]
    lines.append(f"  docCount: {CORPUS_DOC_COUNT},")
    lines.append(f"  label: '{CORPUS_DOC_COUNT} Control-M docs + manifest',")
    lines.append(f"  totalChars: {CORPUS_TOTAL_CHARS:_},")
    lines.append(f"  chunkCount: {CORPUS_CHUNK_COUNT},")
    lines.append("  tiers: [")
    for t in tiers:
        lines.append(
            f"    {{ tier: {_ts_str(t['tier'])}, chunks: {t['chunks']}, chars: {t['chars']:_}, token: {_ts_str(t['token'])} }},"
        )
    lines.append("  ],")
    lines.append("} as const")
    return "\n".join(lines)


def _emit_totals(totals: dict) -> str:
    lines = ["export const TOTALS = {"]
    for arm in ("traversal", "fulltext", "manifest"):
        t = totals[arm]
        parts = [f"chars: {t['chars']:_}", f"tokens: {_ts_str(t['tokens'])}", f"recall: {_ts_str(t['recall'])}"]
        if "latencyMedianMs" in t:
            parts.append(f"latencyMedianMs: {t['latencyMedianMs']}")
        if "latencyLabel" in t:
            parts.append(f"latencyLabel: {_ts_str(t['latencyLabel'])}")
        lines.append(f"  {arm}: {{ {', '.join(parts)} }},")
    lines.append("} as const")
    return "\n".join(lines)


def _emit_efficiency(eff: dict) -> str:
    return (
        "export const EFFICIENCY = {\n"
        f"  headline: {_ts_str(eff['headline'])},\n"
        f"  label: {_ts_str(eff['label'])},\n"
        f"  perQuestionRange: {_ts_str(eff['perQuestionRange'])},\n"
        "} as const"
    )


def _emit_class_token() -> str:
    lines = ["export const CLASS_TOKEN: Record<QuestionClass, string> = {"]
    for cls, tok in CLASS_TOKEN.items():
        lines.append(f"  {_ts_str(cls)}: {_ts_str(tok)},")
    lines.append("}")
    return "\n".join(lines)


def _emit_strategy_result(r: dict) -> str:
    parts = [f"kind: {_ts_str(r['kind'])}", f"chars: {r['chars']:_}"]
    if "ms" in r:
        parts.append(f"ms: {r['ms']}")
    if "qualifier" in r:
        parts.append(f"qualifier: {_ts_str(r['qualifier'])}")
    return "{ " + ", ".join(parts) + " }"


def _emit_questions(questions: list[dict]) -> str:
    lines = ["export const QUESTIONS: readonly BenchmarkQuestion[] = ["]
    for q in questions:
        lines.append("  {")
        lines.append(f"    id: {_ts_str(q['id'])},")
        lines.append(f"    cls: {_ts_str(q['cls'])},")
        lines.append(f"    text: {_ts_str(q['text'])},")
        lines.append(f"    traversal: {_emit_strategy_result(q['traversal'])},")
        lines.append(f"    fulltext: {_emit_strategy_result(q['fulltext'])},")
        lines.append(f"    manifest: {_emit_strategy_result(q['manifest'])},")
        lines.append(f"    note: {_ts_str(q['note'])},")
        if q["cypher"]:
            lines.append("    cypher: [")
            for label, code in q["cypher"]:
                lines.append("      {")
                lines.append(f"        label: {_ts_str(label)},")
                lines.append(f"        code: {_ts_str(code)},")
                lines.append("      },")
            lines.append("    ],")
        lines.append("  },")
    lines.append("]")
    return "\n".join(lines)


HEADER = """// GENERATED by scripts/render_benchmark_data.py — DO NOT hand-edit.
// Regenerate: poetry run python scripts/render_benchmark_data.py
// Drift guard: tests/unit/test_benchmark_data_ts.py
//
// Source of the numbers: knowledge/upgrade-plans/p0-benchmark/benchmark_p0_results.json
// (the real 2026-07-16 evaluation-harness run — see that script's own header
// and knowledge/upgrade-plans/docmeta-p0-verdict.md's Setup table for how it
// was produced). The per-question "kind" classification is a cited, literal
// transcription of the verdict's Results table (why: see the render
// script's module docstring — raw marker-regex hits are not trustworthy
// ground truth on this dataset in either direction). Everything else below
// (TOTALS, EFFICIENCY, the strategy-card recall/tokens/latency strings) is
// COMPUTED from the per-question table, not retyped, which is what makes
// this a regeneration step rather than a second hand transcription.
//
// "Under the Hood" (/under-the-hood) renders this as a benchmark showcase —
// how the DryDocs agent could retrieve knowledge three different ways, and
// the live test that decided BUILD over shrink-to-registry-only.
"""

TYPES = """
export type StrategyId = 'manifest' | 'fulltext' | 'traversal'

export interface StrategyInfo {
  id: StrategyId
  label: string
  /** the mono kicker shown on the strategy card, e.g. "unstructured files" */
  kicker: string
  how: string
  recall: string
  tokens: string
  latency: string
  failureModes: string
  /** css custom-property token name (no leading `var()`), e.g. '--yellow' */
  token: string
}
"""

MID_TYPES = """
export type ResultKind = 'pass' | 'fail' | 'partial' | 'abstain' | 'hallucination'

export interface StrategyResult {
  kind: ResultKind
  /** characters retrieved/ingested for this question, this strategy */
  chars: number
  ms?: number
  /** e.g. "informed" — naive phrasing failed, domain-mapped terms succeeded */
  qualifier?: string
}

export type QuestionClass =
  | 'structure/aggregation'
  | 'exact lookup'
  | 'paraphrase'
  | 'multi-doc'
  | 'provenance'
  | 'out-of-scope'
"""

CYPHER_TYPES = """
export interface CypherSnippet {
  label: string
  code: string
}

export interface BenchmarkQuestion {
  id: string
  cls: QuestionClass
  text: string
  traversal: StrategyResult
  fulltext: StrategyResult
  manifest: StrategyResult
  note: string
  cypher?: readonly CypherSnippet[]
}
"""


def build_module_source() -> str:
    questions = build_questions()
    tiers = build_corpus_tiers()
    totals = build_totals(questions)
    efficiency = build_efficiency(totals, questions)
    strategies = build_strategies(totals)

    provenance_line = (
        "Live benchmark 2026-07-16 \u00b7 full record: knowledge/upgrade-plans/docmeta-p0-verdict.md \u00b7 "
        "explainer: docs/design/graph-retrieval-benchmark-explainer.md \u00b7 regenerated by "
        "scripts/render_benchmark_data.py from benchmark_p0_results.json"
    )

    parts = [
        HEADER,
        TYPES,
        _emit_strategies(strategies),
        "",
        _emit_corpus(tiers),
        "",
        _emit_totals(totals),
        "",
        _emit_efficiency(efficiency),
        MID_TYPES,
        _emit_class_token(),
        CYPHER_TYPES,
        _emit_questions(questions),
        "",
        f"export const PROVENANCE_LINE =\n  {_ts_str(provenance_line + ' ')}+\n  {_ts_str('· commit 0e036ff')}",
        "",
    ]
    return "\n".join(parts)


def main() -> None:
    src = build_module_source()
    OUT.write_text(src, encoding="utf-8", newline="\n")
    print(f"wrote {OUT}")


if __name__ == "__main__":
    main()

