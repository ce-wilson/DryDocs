def _round_half_up(x: float) -> int:
    """round(), but half-away-from-zero (JS ``Math.round`` convention) instead
    of Python's banker's rounding — matters here because the JSON has two
    exact .5ms readings (MD1 traversal 108.5, OS1 traversal 16.5) and the
    original hand-typed file rounded both up (109, 17); Python's built-in
    ``round()`` would silently flip them down (108, 16, since both are even),
    a one-millisecond drift with no data behind it."""
    return math.floor(x + 0.5)

