# drydocs-agents — copy to .env (gitignored) and fill in.

# --- Neo4j (local Docker EE container — canonical names/ports: config/dev-environment.yaml)
#
# THE PASSWORD LINE IS COMMENTED OUT AND THE OTHERS ARE NOT (G131), and the
# difference is the whole point. The agent tier reads this file first and the
# repo-root .env as a fallback, so a name declared here with NO value is not
# "unset" — it is SET, to the empty string, and it shadows the root value. A
# blank `NEO4J_PASSWORD=` therefore gave the whole tier an empty password, and
# only survived because the fallback treated "" as absent.
#
# The three lines below carry REAL values, so they override with something and
# are not the defect; config/dev-environment.yaml is their canonical source and
# tests/unit/test_dev_environment.py holds them to it. The password has no value
# to declare here, so it declares nothing: uncomment and fill it only to point
# the agents at a DIFFERENT graph from the rest of the repo.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
#NEO4J_PASSWORD=
NEO4J_DATABASE=drydocs

# --- Google ADK / Gemini -------------------------------------------------------
# Needed only for the LEGACY demo LLM agents (core_ingest, controlm_fix) —
# kept until they are rewired onto the graph_qa provider adapter.
# The graph_query app is deterministic and runs without any key.
# Commented for the same reason as the Neo4j block above: a blank line here is a
# value, and it shadows the root file.
#GOOGLE_API_KEY=
ADK_MODEL=gemini-flash-latest

# --- graph_qa (Epic R / ADR 0007; provider ruling = R1 gate 2026-07-23) --------
# ENVIRONMENT-SPLIT: local/producer -> anthropic; company runtime -> azure.
# Model ids/endpoints live HERE, never in code.
GRAPHQA_PROVIDER=anthropic
GRAPHQA_MODEL=claude-sonnet-4-6
# The root .env declares this one too; leave it commented unless the agent tier
# needs a different key from the rest of the repo.
#ANTHROPIC_API_KEY=
# company runtime (GRAPHQA_PROVIDER=azure; GRAPHQA_MODEL=<deployment name>):
#AZURE_API_KEY=
#AZURE_API_BASE=
#AZURE_API_VERSION=2024-10-21
