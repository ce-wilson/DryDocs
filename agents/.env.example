# drydocs-agents — copy to .env (gitignored) and fill in.

# --- Neo4j (local Docker EE container — canonical names/ports: config/dev-environment.yaml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=drydocs

# --- Google ADK / Gemini -------------------------------------------------------
# Needed only for the LLM agents (core_ingest, controlm_fix).
# The graph_query app is deterministic and runs without any key.
GOOGLE_API_KEY=
ADK_MODEL=gemini-flash-latest
