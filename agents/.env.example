# drydocs-agents — copy to .env (gitignored) and fill in.

# --- Neo4j (local Docker EE container — canonical names/ports: config/dev-environment.yaml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=drydocs

# --- Google ADK / Gemini -------------------------------------------------------
# Needed only for the LEGACY demo LLM agents (core_ingest, controlm_fix) —
# kept until they are rewired onto the graph_qa provider adapter.
# The graph_query app is deterministic and runs without any key.
GOOGLE_API_KEY=
ADK_MODEL=gemini-flash-latest

# --- graph_qa (Epic R / ADR 0007; provider ruling = R1 gate 2026-07-23) --------
# ENVIRONMENT-SPLIT: local/producer -> anthropic; company runtime -> azure.
# Model ids/endpoints live HERE, never in code.
GRAPHQA_PROVIDER=anthropic
GRAPHQA_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# company runtime (GRAPHQA_PROVIDER=azure; GRAPHQA_MODEL=<deployment name>):
#AZURE_API_KEY=
#AZURE_API_BASE=
#AZURE_API_VERSION=2024-10-21
